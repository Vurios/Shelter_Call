/bundles/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/workbox-*.js
  Cache-Control: no-cache

/assets/models/*.glb
  Content-Type: model/gltf-binary

/data/*.json
  Content-Type: application/json; charset=utf-8

/assets/manifest.json
  Content-Type: application/json; charset=utf-8
